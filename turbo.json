{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "ROBYN_BUILD_ID",
    "NEXT_SERVER_ACTIONS_ENCRYPTION_KEY",
    "SOURCE_DATE_EPOCH",
    "TZ",
    "LC_ALL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] }
  }
}
