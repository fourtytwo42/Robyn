[Unit]
Description=Bounded seven-day Mainnet staging retention
After=postgresql.service

[Service]
Type=oneshot
User=hendo420
Environment=ROBYN_STAGING_MAINNET_DATABASE=robyn_mainnet
Environment=ROBYN_STAGING_RETENTION_DAYS=7
ExecStart=/usr/local/lib/robyn/prune-mainnet-staging-history.sh --execute
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
