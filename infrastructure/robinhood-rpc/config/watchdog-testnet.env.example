RESTART_COOLDOWN_SECONDS=1800
STATE_FILE=/var/lib/robinhood/testnet-watchdog.json
CONFIRM_RPC=https://robinhood-testnet.drpc.org
CANONICAL_CHECK_DEPTH=1000
CANONICAL_MISMATCH_LIMIT=2
