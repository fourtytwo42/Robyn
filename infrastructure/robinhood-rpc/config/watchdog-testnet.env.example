NETWORK=testnet
SERVICE=robinhood-testnet-node.service
LOCAL_RPC=http://127.0.0.1:18547
PUBLIC_RPC=https://rpc.testnet.chain.robinhood.com
EXPECTED_CHAIN_ID=0xb626
LAG_THRESHOLD=360
FAILURE_LIMIT=3
STALL_LIMIT=5
