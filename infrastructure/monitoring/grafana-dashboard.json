      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["min"], "values": false}},
      "targets": [{"expr": "min(robyn_component_up)", "refId": "A"}],
      "title": "Application health",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "robyn-prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}},
