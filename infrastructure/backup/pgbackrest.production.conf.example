[global]
repo1-type=posix
repo1-path=/mnt/robyn-backups/pgbackrest
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=INSTALL_DEDICATED_ENCRYPTION_PASSPHRASE
repo1-retention-full=3
repo1-retention-full-type=count
repo1-bundle=y
repo1-block=y
start-fast=y
process-max=2
log-level-console=info

[robyn-mainnet]
pg1-path=/var/lib/postgresql/16/main
pg1-port=5432
