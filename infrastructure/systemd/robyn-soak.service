[Unit]
Description=Robyn exact-release soak gate
Requires=pm2-hendo420.service nginx.service prometheus.service
After=pm2-hendo420.service nginx.service prometheus.service

[Service]
Type=simple
User=hendo420
Group=hendo420
WorkingDirectory=/opt/robyn/current
Environment=SOAK_DURATION_SECONDS=28800
Environment=SOAK_INTERVAL_SECONDS=30
Environment=SOAK_OUTPUT_DIR=/var/lib/robyn/soak
ExecStart=/opt/node-v24.18.0-linux-x64/bin/node /opt/robyn/current/scripts/soak-release.mjs
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/robyn/soak /home/hendo420/.pm2
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RemoveIPC=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
