[Unit]
Description=Sherwood Forest production Cloudflare Tunnel
After=network-online.target nginx.service
Wants=network-online.target

[Service]
User=cloudflared
Group=cloudflared
EnvironmentFile=/etc/robyn/mainnet/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token ${TUNNEL_TOKEN}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/robyn/mainnet/cloudflared.env

[Install]
WantedBy=multi-user.target
