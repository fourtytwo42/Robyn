NETWORK=mainnet
SERVICE=robinhood-mainnet-node.service
LOCAL_RPC=http://127.0.0.1:18547
PUBLIC_RPC=https://rpc.mainnet.chain.robinhood.com
EXPECTED_CHAIN_ID=0x1237
LAG_THRESHOLD=1200
FAILURE_LIMIT=3
STALL_LIMIT=5
LAG_LIMIT=5
RESTART_COOLDOWN_SECONDS=1800
STATE_FILE=/var/lib/robinhood/mainnet-watchdog.json
CONFIRM_RPC=https://rpc.nodeflare.app/robinhood/public
CANONICAL_CHECK_DEPTH=1000
CANONICAL_MISMATCH_LIMIT=2
