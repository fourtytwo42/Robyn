pragma solidity 0.8.30;

import { Script } from "forge-std/Script.sol";
import { console2 } from "forge-std/console2.sol";
import { IERC20 } from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import { IPoolManager } from "@uniswap/v4-core/src/interfaces/IPoolManager.sol";
import { IPositionManager } from "@uniswap/v4-periphery/src/interfaces/IPositionManager.sol";
import { IStateView } from "@uniswap/v4-periphery/src/interfaces/IStateView.sol";
import { IV4Quoter } from "@uniswap/v4-periphery/src/interfaces/IV4Quoter.sol";
import { IAllowanceTransfer } from "permit2/src/interfaces/IAllowanceTransfer.sol";
import { RobynTokenSink } from "../src/RobynTokenSink.sol";
import { RobynBootstrapTimelock } from "../src/dao/RobynBootstrapTimelock.sol";
import { RobynDaoTokenV2 } from "../src/dao/RobynDaoTokenV2.sol";
import { RobynGovernorV2 } from "../src/dao/RobynGovernorV2.sol";
import { RobynNativeLaunchDeployerV4 } from "../src/uniswap/RobynNativeLaunchDeployerV4.sol";
import { RobynNativeLaunchFactoryV4 } from "../src/uniswap/RobynNativeLaunchFactoryV4.sol";
import { RobynNativeVaultDeployerV4 } from "../src/uniswap/RobynNativeVaultDeployerV4.sol";
import { RobynNativeProtocolFeeRouterV4 } from "../src/uniswap/RobynNativeProtocolFeeRouterV4.sol";
import { RobynV4AssetRouter, IWrappedNative } from "../src/uniswap/RobynV4AssetRouter.sol";
import { RobynV4AdapterDeployer } from "../src/uniswap/RobynV4AdapterDeployer.sol";
import { RobynV4BondingCurveMarket } from "../src/uniswap/RobynV4BondingCurveMarket.sol";
import { RobynV4FeeAndPhaseHook } from "../src/uniswap/RobynV4FeeAndPhaseHook.sol";
import { RobynV4LaunchCoordinatorV6 } from "../src/uniswap/RobynV4LaunchCoordinatorV6.sol";
import { RobynV4LockerDeployer } from "../src/uniswap/RobynV4LockerDeployer.sol";
import { RobynV4MarketDeployer } from "../src/uniswap/RobynV4MarketDeployer.sol";
import { RobynV4MarketFactory } from "../src/uniswap/RobynV4MarketFactory.sol";

interface ISchema17Safe {
    function getOwners() external view returns (address[] memory);
    function getThreshold() external view returns (uint256);
    function execTransaction(
        address to,
        uint256 value,
        bytes calldata data,
        uint8 operation,
        uint256 safeTxGas,
        uint256 baseGas,
        uint256 gasPrice,
        address gasToken,
        address payable refundReceiver,
        bytes calldata signatures
    ) external payable returns (bool success);
}

/// @notice Exact Schema-17 deployment broadcaster for an already verified 1-of-1 Safe.
/// @dev The prepared JSON is generated by scripts/prepare-schema17-deployment.mjs.
contract DeploySchema17 is Script {
    address private constant ZERO = address(0);

    struct ExternalContracts {
        address create2Deployer;
        IPoolManager poolManager;
        IPositionManager positionManager;
        IV4Quoter quoter;
        IStateView stateView;
        IAllowanceTransfer permit2;
        IWrappedNative wrappedNative;
    }

    struct Stack {
        RobynDaoTokenV2 daoToken;
        RobynV4AssetRouter assetRouter;
        RobynNativeLaunchDeployerV4 launchDeployer;
        RobynNativeVaultDeployerV4 vaultDeployer;
        RobynNativeLaunchFactoryV4 launchFactory;
        RobynNativeProtocolFeeRouterV4 feeRouter;
        RobynTokenSink tokenSink;
        RobynV4FeeAndPhaseHook oracleHook;
        RobynV4AdapterDeployer adapterDeployer;
        RobynV4LockerDeployer lockerDeployer;
        RobynV4MarketDeployer marketDeployer;
        RobynV4MarketFactory marketFactory;
        RobynV4LaunchCoordinatorV6 coordinator;
        RobynBootstrapTimelock timelock;
        RobynGovernorV2 governor;
    }

    struct DeploymentConfig {
        string json;
        uint256 startingNonce;
        address deployer;
        address guardian;
        address predictedTimelock;
        bytes32 hookSalt;
        bytes32 hookDomain;
        bytes32 hookInitCodeHash;
        bytes32 bootstrapDomain;
        bytes32[2] bootstrapPlans;
        ExternalContracts externalContracts;
    }

    function run() external {
        DeploymentConfig memory config = _loadConfig();
        _verifySafe(config.guardian, config.deployer);
        require(vm.getNonce(config.deployer) == config.startingNonce, "Schema-17 nonce changed");

        vm.startBroadcast();
        Stack memory stack = _deployCore(config);
        _bind(stack, config.deployer, config.guardian);
        vm.stopBroadcast();

        _verify(stack, config.deployer, config.guardian, config.bootstrapPlans, config.json);
        _log(stack);
    }

    function _loadConfig() private view returns (DeploymentConfig memory config) {
        config.json = vm.readFile(vm.envString("SCHEMA17_DEPLOYMENT_INPUT"));
        require(block.chainid == vm.parseJsonUint(config.json, ".chainId"), "Schema-17 wrong chain");
        require(vm.parseJsonUint(config.json, ".schemaVersion") == 17, "Schema-17 input required");
        require(!vm.parseJsonBool(config.json, ".provisional"), "provisional input");
        config.deployer = vm.parseJsonAddress(config.json, ".deployment.deployer");
        config.startingNonce = vm.parseJsonUint(config.json, ".deployment.startingNonce");
        config.guardian = vm.parseJsonAddress(config.json, ".governance.guardianSafe");
        config.predictedTimelock =
            vm.parseJsonAddress(config.json, ".deployment.contracts.timelock");
        config.bootstrapDomain = vm.parseJsonBytes32(config.json, ".governance.bootstrap.domain");
        bytes32[] memory planHashes = abi.decode(
            vm.parseJson(config.json, ".governance.governance.bootstrapPlanHashes"), (bytes32[])
        );
        require(planHashes.length == 2, "two bootstrap hashes required");
        config.bootstrapPlans = [planHashes[0], planHashes[1]];
        config.externalContracts = _externalContracts(config.json);
        config.hookSalt = vm.parseJsonBytes32(config.json, ".oracleHook.salt");
        config.hookDomain = vm.parseJsonBytes32(config.json, ".oracleHook.domain");
        config.hookInitCodeHash = vm.parseJsonBytes32(config.json, ".oracleHook.initCodeHash");
    }

    function _externalContracts(string memory json)
        private
        view
        returns (ExternalContracts memory result)
    {
        result = ExternalContracts({
            create2Deployer: vm.parseJsonAddress(json, ".external.create2Deployer"),
            poolManager: IPoolManager(vm.parseJsonAddress(json, ".external.poolManager")),
            positionManager: IPositionManager(
                vm.parseJsonAddress(json, ".external.positionManager")
            ),
            quoter: IV4Quoter(vm.parseJsonAddress(json, ".external.quoter")),
            stateView: IStateView(vm.parseJsonAddress(json, ".external.stateView")),
            permit2: IAllowanceTransfer(vm.parseJsonAddress(json, ".external.permit2")),
            wrappedNative: IWrappedNative(vm.parseJsonAddress(json, ".external.wrappedNative"))
        });
        require(result.create2Deployer.code.length != 0, "CREATE2 deployer missing");
        require(address(result.poolManager).code.length != 0, "PoolManager missing");
        require(address(result.positionManager).code.length != 0, "PositionManager missing");
        require(address(result.quoter).code.length != 0, "Quoter missing");
        require(address(result.stateView).code.length != 0, "StateView missing");
        require(address(result.permit2).code.length != 0, "Permit2 missing");
        require(address(result.wrappedNative).code.length != 0, "WETH missing");
    }

    function _deployCore(DeploymentConfig memory config) private returns (Stack memory stack) {
        ExternalContracts memory ext = config.externalContracts;
        address deployer = config.deployer;
        address guardian = config.guardian;
        address predictedTimelock = config.predictedTimelock;
        string memory json = config.json;
        address[] memory recipients = new address[](1);
        recipients[0] = deployer;
        uint256[] memory allocations = new uint256[](1);
        allocations[0] = 1_000_000_000 ether;
        stack.daoToken = new RobynDaoTokenV2(recipients, allocations, 1 hours, deployer);
        _requirePredicted(json, "daoToken", address(stack.daoToken));

        stack.assetRouter = new RobynV4AssetRouter(
            ext.poolManager,
            ext.quoter,
            ext.stateView,
            predictedTimelock,
            guardian,
            ext.wrappedNative
        );
        _requirePredicted(json, "assetRouter", address(stack.assetRouter));
        stack.launchDeployer = new RobynNativeLaunchDeployerV4(1 hours);
        _requirePredicted(json, "launchDeployer", address(stack.launchDeployer));
        stack.vaultDeployer = new RobynNativeVaultDeployerV4();
        _requirePredicted(json, "vaultDeployer", address(stack.vaultDeployer));
        stack.launchFactory = new RobynNativeLaunchFactoryV4(
            stack.assetRouter, stack.launchDeployer, stack.vaultDeployer, 1 wei, 1 hours
        );
        _requirePredicted(json, "launchFactory", address(stack.launchFactory));
        stack.feeRouter = new RobynNativeProtocolFeeRouterV4(
            stack.daoToken, stack.assetRouter, payable(predictedTimelock), guardian, 1 hours
        );
        _requirePredicted(json, "feeRouter", address(stack.feeRouter));
        stack.tokenSink = new RobynTokenSink();
        _requirePredicted(json, "tokenSink", address(stack.tokenSink));

        bytes memory hookInitCode = abi.encodePacked(
            type(RobynV4FeeAndPhaseHook).creationCode,
            abi.encode(
                ext.poolManager, stack.feeRouter, deployer, ext.positionManager, config.hookDomain
            )
        );
        require(keccak256(hookInitCode) == config.hookInitCodeHash, "hook init code changed");
        address expectedHook =
            vm.computeCreate2Address(config.hookSalt, config.hookInitCodeHash, ext.create2Deployer);
        _requirePredicted(json, "oracleHook", expectedHook);
        (bool hookCreated,) =
            ext.create2Deployer.call(abi.encodePacked(config.hookSalt, hookInitCode));
        require(hookCreated && expectedHook.code.length != 0, "hook deployment failed");
        stack.oracleHook = RobynV4FeeAndPhaseHook(payable(expectedHook));

        stack.adapterDeployer = new RobynV4AdapterDeployer();
        _requirePredicted(json, "adapterDeployer", address(stack.adapterDeployer));
        stack.lockerDeployer = new RobynV4LockerDeployer();
        _requirePredicted(json, "lockerDeployer", address(stack.lockerDeployer));
        stack.marketDeployer = new RobynV4MarketDeployer();
        _requirePredicted(json, "marketDeployer", address(stack.marketDeployer));
        stack.marketFactory = new RobynV4MarketFactory(
            RobynV4MarketFactory.Dependencies({
                launchFactory: stack.launchFactory,
                feeRouter: stack.feeRouter,
                assetRouter: stack.assetRouter,
                oracleHook: stack.oracleHook,
                poolManager: ext.poolManager,
                positionManager: ext.positionManager,
                permit2: ext.permit2,
                stateView: ext.stateView,
                adapterDeployer: stack.adapterDeployer,
                lockerDeployer: stack.lockerDeployer,
                marketDeployer: stack.marketDeployer,
                tokenSink: address(stack.tokenSink)
            }),
            RobynV4BondingCurveMarket.CurveConfig({
                curveTokenAllocation: 800_000_000 ether,
                graduationTokenAllocation: 200_000_000 ether,
                initialVirtualTokenReserve: 1_066_666_666_666_666_666_666_666_666,
                initialVirtualNativeReserve: 1,
                graduationThresholdNative: 0.01 ether,
                maximumCurvePurchase: 0.001 ether,
                curveFeeBps: 100
            }),
            9_900,
            0.00025 ether,
            1 gwei,
            0.000001 ether
        );
        _requirePredicted(json, "marketFactory", address(stack.marketFactory));
        stack.coordinator = new RobynV4LaunchCoordinatorV6(
            stack.launchFactory, stack.marketFactory, stack.feeRouter, predictedTimelock, guardian
        );
        _requirePredicted(json, "coordinator", address(stack.coordinator));
        stack.timelock = new RobynBootstrapTimelock(
            IERC20(address(stack.daoToken)),
            deployer,
            guardian,
            config.bootstrapDomain,
            config.bootstrapPlans
        );
        require(address(stack.timelock) == predictedTimelock, "timelock prediction changed");
        stack.governor = new RobynGovernorV2(stack.daoToken, stack.timelock);
        _requirePredicted(json, "governor", address(stack.governor));
    }

    function _bind(Stack memory stack, address deployer, address guardian) private {
        stack.launchDeployer.bindController(address(stack.launchFactory));
        stack.vaultDeployer.bindController(address(stack.launchFactory));
        stack.adapterDeployer.bindController(address(stack.marketFactory));
        stack.lockerDeployer.bindController(address(stack.marketFactory));
        stack.marketDeployer.bindController(address(stack.marketFactory));
        stack.oracleHook.bindRegistrar(address(stack.marketFactory));
        stack.assetRouter.bindLaunchRegistrar(address(stack.marketFactory));
        stack.launchFactory.bindCoordinator(address(stack.coordinator));
        stack.marketFactory.bindCoordinator(address(stack.coordinator));
        stack.feeRouter.bindCoordinator(address(stack.coordinator));
        stack.daoToken.bindBootstrapController(address(stack.timelock));

        address[] memory exclusions = new address[](15);
        exclusions[0] = address(stack.timelock);
        exclusions[1] = address(stack.governor);
        exclusions[2] = address(stack.feeRouter);
        exclusions[3] = address(stack.coordinator);
        exclusions[4] = address(stack.marketFactory);
        exclusions[5] = address(stack.launchFactory);
        exclusions[6] = address(stack.launchDeployer);
        exclusions[7] = address(stack.vaultDeployer);
        exclusions[8] = address(stack.assetRouter);
        exclusions[9] = address(stack.oracleHook);
        exclusions[10] = address(stack.adapterDeployer);
        exclusions[11] = address(stack.lockerDeployer);
        exclusions[12] = address(stack.marketDeployer);
        exclusions[13] = address(stack.tokenSink);
        exclusions[14] = guardian;
        stack.daoToken.sealRewardExclusions(exclusions);
        stack.daoToken.bindRewardDepositor(address(stack.feeRouter));
        stack.daoToken.delegate(deployer);

        stack.timelock.grantRole(stack.timelock.PROPOSER_ROLE(), address(stack.governor));
        stack.timelock.grantRole(stack.timelock.CANCELLER_ROLE(), guardian);
        stack.timelock.grantRole(stack.timelock.EXECUTOR_ROLE(), ZERO);
        stack.timelock.renounceRole(stack.timelock.DEFAULT_ADMIN_ROLE(), deployer);

        _safeCall(
            guardian,
            deployer,
            address(stack.assetRouter),
            abi.encodeCall(RobynV4AssetRouter.pauseConversions, ())
        );
        _safeCall(
            guardian,
            deployer,
            address(stack.feeRouter),
            abi.encodeCall(RobynNativeProtocolFeeRouterV4.setPaused, (true))
        );
    }

    function _safeCall(address safeAddress, address owner, address target, bytes memory data)
        private
    {
        bytes memory prevalidatedSignature =
            abi.encodePacked(bytes12(0), owner, bytes32(0), uint8(1));
        bool success = ISchema17Safe(safeAddress)
            .execTransaction(
                target, 0, data, 0, 0, 0, 0, ZERO, payable(ZERO), prevalidatedSignature
            );
        require(success, "Safe pause failed");
    }

    function _verify(
        Stack memory stack,
        address deployer,
        address guardian,
        bytes32[2] memory plans,
        string memory json
    ) private view {
        _verifySafe(guardian, deployer);
        require(stack.daoToken.totalSupply() == 1_000_000_000 ether, "RDAO supply mismatch");
        require(stack.daoToken.balanceOf(deployer) == stack.daoToken.totalSupply(), "RDAO owner");
        require(
            address(stack.daoToken.bootstrapController()) == address(stack.timelock),
            "controller mismatch"
        );
        require(stack.timelock.bootstrapActive(), "bootstrap inactive");
        require(stack.timelock.bootstrapPlanHash(0) == plans[0], "step zero changed");
        require(stack.timelock.bootstrapPlanHash(1) == plans[1], "step one changed");
        require(stack.timelock.getMinDelay() == 1 hours, "Timelock delay mismatch");
        require(stack.governor.votingDelay() == 1 hours, "voting delay mismatch");
        require(stack.governor.votingPeriod() == 4 hours, "voting period mismatch");
        require(stack.governor.proposalThreshold() == 10_000_000 ether, "threshold mismatch");
        require(stack.assetRouter.conversionsPaused(), "asset conversions not paused");
        require(stack.feeRouter.paused(), "fee conversions not paused");
        require(
            stack.coordinator.launchMode() == RobynV4LaunchCoordinatorV6.LaunchMode.Paused,
            "launches not paused"
        );
        require(stack.launchFactory.launchCount() == 0, "unexpected launch");
        require(address(stack.timelock).balance == 0, "unexpected Timelock balance");
        require(address(stack.feeRouter).balance == 0, "unexpected router balance");
        require(
            vm.getNonce(deployer) > vm.parseJsonUint(json, ".deployment.startingNonce"), "nonce"
        );
    }

    function _verifySafe(address safeAddress, address owner) private view {
        require(safeAddress.code.length != 0, "guardian Safe missing");
        address[] memory owners = ISchema17Safe(safeAddress).getOwners();
        require(owners.length == 1 && owners[0] == owner, "Safe owner mismatch");
        require(ISchema17Safe(safeAddress).getThreshold() == 1, "Safe threshold mismatch");
    }

    function _requirePredicted(string memory json, string memory label, address actual)
        private
        view
    {
        address expected = vm.parseJsonAddress(json, string.concat(".deployment.contracts.", label));
        require(actual == expected, string.concat(label, " prediction changed"));
    }

    function _log(Stack memory stack) private view {
        console2.log("SCHEMA17_DAO_TOKEN", address(stack.daoToken));
        console2.log("SCHEMA17_TIMELOCK", address(stack.timelock));
        console2.log("SCHEMA17_GOVERNOR", address(stack.governor));
        console2.log("SCHEMA17_ASSET_ROUTER", address(stack.assetRouter));
        console2.log("SCHEMA17_FEE_ROUTER", address(stack.feeRouter));
        console2.log("SCHEMA17_MARKET_FACTORY", address(stack.marketFactory));
        console2.log("SCHEMA17_COORDINATOR", address(stack.coordinator));
        console2.log("SCHEMA17_ORACLE_HOOK", address(stack.oracleHook));
    }
}
