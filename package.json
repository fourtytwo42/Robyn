{
  "name": "robyn",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "campaign:testnet": "node scripts/testnet-assurance-campaign.mjs",
    "dev": "turbo run dev",
    "endurance:testnet": "node scripts/testnet-endurance.mjs",
    "estimate:mainnet-bridge": "node scripts/estimate-schema18-mainnet-bridge.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:scripts && pnpm test:anvil && pnpm test:contracts && pnpm test:deployment-nonce && pnpm test:deployment-verifier",
    "test:anvil": "bash scripts/smoke-anvil.sh",
    "test:campaign": "node --test scripts/test/testnet-assurance-campaign.test.mjs",
    "test:contracts": "PATH=$HOME/.foundry/bin:$PATH forge test --root packages/contracts -vv",
    "test:contracts:torture:fast": "bash scripts/run-schema16-devnet-torture.sh --tier fast --seed 160001 --release-sha $(git rev-parse HEAD)",
    "test:contracts:torture:deep": "bash scripts/run-schema16-devnet-torture.sh --tier deep --seed 160001 --release-sha $(git rev-parse HEAD)",
    "test:contracts:torture:schema18:fast": "bash scripts/run-schema18-devnet-torture.sh --tier fast --seed 180001 --release-sha $(git rev-parse HEAD)",
    "test:contracts:torture:schema18:deep": "bash scripts/run-schema18-devnet-torture.sh --tier deep --seed 180001 --release-sha $(git rev-parse HEAD)",
    "test:deployment-nonce": "bash scripts/test/testnet-deployment-nonce.test.sh",
    "test:deployment-verifier": "node --test scripts/test/testnet-v4-deployment-verifier.test.mjs",
    "test:endurance": "node --test scripts/test/testnet-endurance-policy.test.mjs scripts/test/endurance-transaction-funding-anvil.test.mjs scripts/test/recover-failed-endurance-bonding.test.mjs",
    "test:mainnet-rehearsal": "node --test scripts/test/mainnet-rehearsal.test.mjs",
    "test:scripts": "find scripts -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "typecheck": "turbo run typecheck",
    "measure:mainnet-funding": "node scripts/measure-schema18-mainnet-funding.mjs",
    "rehearse:mainnet-broadcast": "node scripts/run-schema18-mainnet-fork-broadcast.mjs",
    "derive:mainnet-bridge-amount": "node scripts/derive-schema18-mainnet-bridge-amount.mjs",
    "compare:mainnet-fork-evidence": "node scripts/compare-schema16-mainnet-fork-evidence.mjs",
    "seal:mainnet-manifest": "node scripts/seal-schema18-mainnet-manifest.mjs",
    "reseal:mainnet-rpc-policy": "node scripts/reseal-schema16-mainnet-rpc-policy.mjs",
    "verify:mainnet-rpc-policy": "node scripts/verify-schema18-mainnet-rpc-policy.mjs",
    "bridge:mainnet": "node scripts/run-schema18-mainnet-live.mjs bridge",
    "deploy:mainnet-paused": "node scripts/run-schema18-mainnet-live.mjs deploy",
    "verify:mainnet-deployment": "node scripts/run-schema18-mainnet-live.mjs verify",
    "rehearse:mainnet-canary": "node scripts/run-schema16-mainnet-canary.mjs",
    "prepare:mainnet-canary": "node scripts/prepare-schema16-mainnet-canary.mjs",
    "prepare:schema17-governance": "node scripts/prepare-schema17-governance.mjs",
    "prepare:schema17-deployment": "node scripts/prepare-schema17-deployment.mjs",
    "finalize:schema17-testnet-manifest": "node scripts/finalize-schema17-testnet-manifest.mjs",
    "test:schema17-governance": "node --test scripts/test/schema17-governance.test.mjs",
    "test:schema17-deployment": "node --test scripts/test/schema17-deployment.test.mjs",
    "test:schema17-deployment-preparer": "node --test scripts/test/prepare-schema17-deployment.test.mjs",
    "verify:schema17-deployment": "node scripts/verify-schema17-deployment.mjs",
    "test:schema17-verifier": "node --test scripts/test/schema17-verifier.test.mjs",
    "prepare:schema18-governance": "node scripts/prepare-schema18-governance.mjs",
    "prepare:schema18-deployment": "node scripts/prepare-schema18-deployment.mjs",
    "finalize:schema18-testnet-manifest": "node scripts/finalize-schema18-testnet-manifest.mjs",
    "test:schema18-governance": "node --test scripts/test/schema18-governance.test.mjs",
    "test:schema18-deployment": "node --test scripts/test/schema18-deployment.test.mjs",
    "test:schema18-deployment-preparer": "node --test scripts/test/prepare-schema18-deployment.test.mjs",
    "verify:schema18-deployment": "node scripts/verify-schema18-deployment.mjs",
    "test:schema18-verifier": "node --test scripts/test/schema18-verifier.test.mjs",
    "run:mainnet-canary": "node scripts/run-schema16-mainnet-canary-live.mjs",
    "observe:mainnet-canary": "node scripts/observe-schema16-mainnet-canary.mjs",
    "validate:mainnet-governance": "node scripts/validate-mainnet-governance-inputs.mjs",
    "validate:mainnet-curve": "node scripts/validate-mainnet-curve.mjs",
    "validate:mainnet-support": "node scripts/validate-mainnet-support-policy.mjs",
    "verify:mainnet-rehearsal": "node scripts/verify-mainnet-production-routes.mjs",
    "verify:mainnet-governance": "node scripts/verify-mainnet-governance-deployment.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@uniswap/universal-router": "2.1.0",
    "@uniswap/v3-core": "1.0.0",
    "@uniswap/v3-periphery": "1.4.4",
    "@uniswap/v4-core": "1.0.2",
    "@uniswap/v4-periphery": "1.0.3",
    "pm2": "7.0.3",
    "prettier": "3.9.5",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "viem": "2.55.4"
  }
}
