[Unit]
Description=Robyn private Kubo IPFS node
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
User=robyn-ipfs
Group=robyn-ipfs
Environment=IPFS_PATH=/var/lib/robyn-ipfs
EnvironmentFile=-/etc/robyn/ipfs.env
ExecStart=/usr/local/bin/ipfs daemon --migrate=true --enable-gc
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/robyn-ipfs
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RemoveIPC=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
